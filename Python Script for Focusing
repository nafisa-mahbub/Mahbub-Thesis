plt.figure(figsize=(16, 8))

plt.subplot(1, 2, 1)
plt.imshow(convert_bgr_to_rgb(raw_smallest_frame))
plt.title(
    f"Raw smallest diameter frame\n"
    f"Frame {smallest_frame_index}, "
