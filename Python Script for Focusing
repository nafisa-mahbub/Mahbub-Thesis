display_two_frames(
    left_frame=raw_smallest_frame,
    right_frame=raw_largest_frame,
    left_title=(
        f"Raw smallest diameter frame\n"
        f"Frame {smallest_frame_index}, "
        f"{float(smallest_frame_row[selection_metric]):.2f}px\n"
        f"{smallest_focus_mode}"
    ),
    right_title=(
        f"Raw largest diameter frame\n"
        f"Frame {largest_frame_index}, "
        f"{float(largest_frame_row[selection_metric]):.2f}px\n"
        f"{largest_focus_mode}"
    )
)


# =========================
# Display annotated frames
# =========================

display_two_frames(
    left_frame=annotated_smallest_frame,
    right_frame=annotated_largest_frame,
    left_title="Annotated smallest diameter frame",
    right_title="Annotated largest diameter frame"
)


