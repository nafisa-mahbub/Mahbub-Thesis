# Figure 4.1 and 4.2
# Libraries

from pathlib import Path

import cv2
import numpy as np
import pandas as pd
from scipy.ndimage import distance_transform_edt
from skimage import measure, morphology
from skimage.segmentation import clear_border


# User input for video file and folder to save outputs

video_path_input = input("Video file path: ").strip().strip('"')
video_path = Path(video_path_input)

if not video_path.exists():
    raise FileNotFoundError(f"The video file was not found: {video_path}")

output_folder_input = input("Output folder path: ").strip().strip('"')

output_folder = Path(output_folder_input)
output_folder.mkdir(parents=True, exist_ok=True)


# Set up the output files as two .csv and two .png

all_frames_csv = output_folder / "all_frame_median_barcode_diameters.csv"
lowest_highest_frames_csv = output_folder / "lowest_and_highest_median_barcode_diameter_frames.csv"

lowest_median_raw_image = output_folder / "RAW_lowest_median_barcode_diameter_frame.png"
highest_median_raw_image = output_folder / "RAW_highest_median_barcode_diameter_frame.png"

# Object detection settings

minimum_object_area_px = 50
opening_radius_px = 1
gaussian_kernel_size = (5, 5)

# Barcode size filters

minimum_barcode_diameter_px = 20.0
maximum_barcode_diameter_px = 120.0

# Cluster filter

h_maxima_height = 1.5

# Proximity filter >> A bead is removed if its centroid is too close to another valid bead

minimum_centroid_distance_factor = 1.10

# Focus selection settings.

minimum_focus_barcodes_per_frame = 5

# Open the video file

def open_video(path):
    video = cv2.VideoCapture(str(path))
    if not video.isOpened():
        raise RuntimeError("The focusing video could not be opened.")
    return video
    
# Read one frame from the video

def read_video_frame(path, frame_index):
    video = cv2.VideoCapture(str(path))
    video.set(cv2.CAP_PROP_POS_FRAMES, frame_index)
    success, frame = video.read()
    video.release()
    if not success:
        raise RuntimeError(f"Frame {frame_index} could not be read.")
    return frame

# Detect bright barcode objects in grayscale image

def make_binary_mask(frame):
    gray_frame = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
    blurred_frame = cv2.GaussianBlur(gray_frame, gaussian_kernel_size, 0)
    _, binary_frame = cv2.threshold(
        blurred_frame,
        0,
        255,
        cv2.THRESH_BINARY + cv2.THRESH_OTSU
    )
    
    binary_mask = binary_frame > 0

    if opening_radius_px > 0:
        binary_mask = morphology.binary_opening(
            binary_mask,
            footprint=morphology.disk(opening_radius_px)
        )

    binary_mask = morphology.remove_small_objects(
        binary_mask,
        min_size=minimum_object_area_px
    )

    return binary_mask

# Measure the equivalent diameter of one detected object

def get_equivalent_diameter(region):
    diameter = getattr(region, "equivalent_diameter_area", None)
    if diameter is None:
        diameter = getattr(region, "equivalent_diameter", None)
    if diameter is None:
        return None
    diameter = float(diameter)
    if np.isnan(diameter) or np.isinf(diameter):
        return None
    return diameter

# Check if the object touches image border
def touches_image_border(bbox, image_shape):

    min_row, min_col, max_row, max_col = bbox
    n_rows, n_cols = image_shape

    return (
        min_row <= 0
        or min_col <= 0
        or max_row >= n_rows
        or max_col >= n_cols
    )

# Single barcode vs cluster of barcode

def count_internal_peaks(label_image, component_label, bbox):

    min_row, min_col, max_row, max_col = bbox

    pad = 2
    row_0 = max(min_row - pad, 0)
    col_0 = max(min_col - pad, 0)
    row_1 = min(max_row + pad, label_image.shape[0])
    col_1 = min(max_col + pad, label_image.shape[1])

    component_mask = label_image[row_0:row_1, col_0:col_1] == component_label
    distance_map = distance_transform_edt(component_mask)

    peaks = morphology.h_maxima(distance_map, h=h_maxima_height)
    peaks = peaks & component_mask
    peaks = clear_border(peaks)

    peak_count = int(measure.label(peaks).max())

    return max(peak_count, 1)

# Identify the barcodes and remove noise

def identify_barcode_objects(frame):

    binary_mask = make_binary_mask(frame)
    label_image = measure.label(binary_mask)
    regions = measure.regionprops(label_image)

    rows = []

    for region in regions:
        equivalent_diameter_px = get_equivalent_diameter(region)

        if equivalent_diameter_px is None:
            continue

        centroid_y, centroid_x = region.centroid

        internal_peak_count = count_internal_peaks(
            label_image=label_image,
            component_label=region.label,
            bbox=region.bbox
        )

        discard_reasons = []

        if region.area < minimum_object_area_px:
            discard_reasons.append("small_area")

        if equivalent_diameter_px < minimum_barcode_diameter_px:
            discard_reasons.append("diameter_too_small")

        if equivalent_diameter_px > maximum_barcode_diameter_px:
            discard_reasons.append("diameter_too_large")

        if internal_peak_count > 1:
            discard_reasons.append("cluster")

        if touches_image_border(region.bbox, label_image.shape):
            discard_reasons.append("touches_border")

        rows.append({
            "centroid_x": float(centroid_x),
            "centroid_y": float(centroid_y),
            "area_px": float(region.area),
            "equivalent_diameter_px": float(equivalent_diameter_px),
            "discard_reason": "; ".join(discard_reasons) if discard_reasons else None
        })

    object_table = pd.DataFrame(rows)

    if object_table.empty:
        return object_table

    object_table = apply_proximity_filter(object_table)
    object_table["is_valid_barcode"] = object_table["discard_reason"].isna()

    return object_table

# Remove barcode if its too close to another barcode

def apply_proximity_filter(object_table):

    object_table = object_table.copy()

    preliminary_valid = object_table["discard_reason"].isna()
    valid_table = object_table[preliminary_valid].copy()

    if len(valid_table) < 2:
        return object_table

    median_diameter = float(valid_table["equivalent_diameter_px"].median())
    minimum_allowed_distance = median_diameter * minimum_centroid_distance_factor

    coordinates = valid_table[["centroid_x", "centroid_y"]].to_numpy()
    valid_indices = valid_table.index.to_list()

    for local_index, global_index in enumerate(valid_indices):
        distances = np.sqrt(
            np.sum((coordinates - coordinates[local_index]) ** 2, axis=1)
        )

        distances[local_index] = np.inf
        nearest_distance = float(np.min(distances))

        if nearest_distance < minimum_allowed_distance:
            current_reason = object_table.at[global_index, "discard_reason"]

            if current_reason is None or pd.isna(current_reason):
                object_table.at[global_index, "discard_reason"] = "too_close_to_other_bead"
            else:
                object_table.at[global_index, "discard_reason"] = (
                    f"{current_reason}; too_close_to_other_bead"
                )

    return object_table


# Return frame number and median barcode diameter

def summarize_frame(object_table, frame_index):

    if object_table.empty:
        return None

    valid_barcodes = object_table[object_table["is_valid_barcode"] == True].copy()

    if len(valid_barcodes) < minimum_focus_barcodes_per_frame:
        return None

    valid_diameters = valid_barcodes["equivalent_diameter_px"].to_numpy()

    return {
        "frame": frame_index,
        "median_barcode_diameter_px": float(np.median(valid_diameters))
    }

# Save raw images

def save_raw_frame(frame, output_path):

    success = cv2.imwrite(str(output_path), frame)

    if not success:
        raise RuntimeError(f"The raw image could not be saved: {output_path}")


# Iterate analysis on each frame

video = open_video(video_path)

frame_summaries = []
frame_index = -1

while True:
    success, frame = video.read()

    if not success:
        break

    frame_index += 1

    object_table = identify_barcode_objects(frame)

    frame_summary = summarize_frame(
        object_table=object_table,
        frame_index=frame_index
    )

    if frame_summary is not None:
        frame_summaries.append(frame_summary)

video.release()

if len(frame_summaries) == 0:
    raise RuntimeError("No valid frames were found. ")

all_frames = pd.DataFrame(frame_summaries)

all_frames = all_frames.sort_values("frame").reset_index(drop=True)
all_frames.to_csv(all_frames_csv, index=False)

# Select lowest and highest median diameter frames

lowest_median_row = all_frames.sort_values(
    ["median_barcode_diameter_px", "frame"],
    ascending=[True, True]
).iloc[0]

highest_median_row = all_frames.sort_values(
    ["median_barcode_diameter_px", "frame"],
    ascending=[False, True]
).iloc[0]

lowest_highest_frames = pd.DataFrame([
    {
        "frame": int(lowest_median_row["frame"]),
        "median_barcode_diameter_px": float(lowest_median_row["median_barcode_diameter_px"])
    },
    {
        "frame": int(highest_median_row["frame"]),
        "median_barcode_diameter_px": float(highest_median_row["median_barcode_diameter_px"])
    }
])

lowest_highest_frames.to_csv(lowest_highest_frames_csv, index=False)

# Save raw images only

lowest_median_frame_index = int(lowest_median_row["frame"])
highest_median_frame_index = int(highest_median_row["frame"])

lowest_frame = read_video_frame(video_path, lowest_median_frame_index)
highest_frame = read_video_frame(video_path, highest_median_frame_index)

save_raw_frame(lowest_frame, lowest_median_raw_image)
save_raw_frame(highest_frame, highest_median_raw_image)
