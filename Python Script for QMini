## Heating to 40 degrees Celsius and incubating for 15 minutes.
def temp_40():
    temp_reading = float(read_temp_c())
    print('The initial temperature is: ' + str(round(temp_reading, 2)) + ' degrees Celsius. ')
    while temp_reading < 47.50:
        print('Heating')
        GPIO.output(heatingElement, GPIO.HIGH)
        kit1.motor3.throttle = 0.23
        time.sleep(0.2)
        kit1.motor3.throttle = 0
        time.sleep(0.1)
        GPIO.output(heatingElement, GPIO.LOW)
        temp_reading = round(float(read_temp_c()), 2)
        print('The temperature is now ' + str(temp_reading) + ' degrees Celsius. ')
    print('The heat block has reached a temperature of ~40 degrees Celsius.')
 
def maintain_40():
    start_time = time.perf_counter()
    now_time = time.perf_counter()
    diff_time = start_time - now_time
    while diff_time < 900:
        main_45 = float(read_temp_c())
        if main_45 < 46.00:
            print('Heating.')
            GPIO.output(heatingElement, GPIO.HIGH)
            kit1.motor2.throttle = 0.23
            time.sleep(0.2)
            kit1.motor2.throttle = 0
            time.sleep(0.1)
            GPIO.output(heatingElement, GPIO.LOW)
        else:
            kit1.motor2.throttle = 0.23
            time.sleep(0.2)
            kit1.motor2.throttle = 0
            print('Maintaining ~40 degrees Celsius. ')
        start_time = time.perf_counter()
        diff_time = round(float(start_time - now_time), 2)
        
        print('It has been ' + str(diff_time) + ' seconds of maintaining at' + str(round(float(read_temp_c()),2)) + ' degrees Celsius. ')
 
