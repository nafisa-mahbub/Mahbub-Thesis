    # Slowly mixing the extracted sample with the lyophilized pellets at 40 degrees Celsius for 15 minutes.
    kit1.motor2.throttle = 0.3
    time.sleep(30) #18 (for movement) +12 for mixing)
    kit1.motor2.throttle = 0
    maintain_40()
    
    print('End amplification. ')
