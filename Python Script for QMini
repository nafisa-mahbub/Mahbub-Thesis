    print('End denaturation. ')
 
def stepDet():
    print('Start detection. ')
    kit1.motor3.throttle = -0.3
    time.sleep(15)
    kit1.motor3.throttle = 0
 
    start_time = time.perf_counter()
    now_time = time.perf_counter()
    diff_time = start_time - now_time
 
    while diff_time < 1200:
        if diff_time < 600:
            kit1.motor3.throttle = -0.3
            time.sleep(0.73)
            kit1.motor3.throttle = 0
            time.sleep(29.5)
        elif 900 < diff_time < 1200:
            kit1.motor3.throttle = -0.25
            time.sleep(0.5)
            kit1.motor3.throttle = 0
            time.sleep(30.5)
        start_time = time.perf_counter()
        diff_time = round(float(start_time - now_time),2)
        print('It has been ' + str(diff_time) + ' seconds. ')
    print('End detection.')
 
def stepLoad():
    print('Dispensing initial volume of wash buffer into detection chamber. ')
    kit1.motor2.throttle = -0.3
    time.sleep(37.00) #42
    kit1.motor2.throttle = 0
    print('Start loading. ')
    kit1.motor1.throttle = 0.3
    time.sleep(11.50)
    kit1.motor1.throttle = 0
    time.sleep(20.00)
    kit1.motor2.throttle = -0.3
    time.sleep(2.5)
    kit1.motor2.throttle = 0
    print('Loading completed. ')
 
def stepWashing():
    print('Washing away unbound sample components and reporter probes. ')
    # Wash buffer
    kit1.motor2.throttle = -0.30
    # Removal to waste
    kit1.motor1.throttle = 0.31 
    time.sleep(101.00)
    # Stop removal to waste
    kit1.motor1.throttle = 0   
    time.sleep(5.28)
    # Stop wash buffer dispensing into the detection chamber,
    kit1.motor2.throttle = 0
    print('Ready for imaging. ')
 
def stepRemoval():
    print('Removal all waste from the base system. ')
    kit1.motor1.throttle = 0.3
    kit1.motor2.throttle = -0.3
    time.sleep(50.00)
    kit1.motor1.throttle = 0
    kit1.motor2.throttle = 0
    print('The cartridge has been processed. ')
 
