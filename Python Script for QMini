# Device Functions
def stepExt():
    print('Start extraction.')
    
    # Dispense 50 uL of FastAmp into the extraction chamber.
    
    kit1.motor1.throttle = 0.6
    time.sleep(23.74)
    kit1.motor3.throttle = 0
    
    # Incubate 50 uL of FastAmp with the sample for 5 minutes at room temperature.
    # Start heating the amplification chamber to 40 degrees Celsius
    
    print('Incubating the sample with the purification-free lysis buffer for 5 minutes at room temperature. ')
    time.sleep(90)
    temp_40_start = time.perf_counter()
    temp_40()
    temp_40_stop = time.perf_counter()
    temp_40_total = temp_40_stop - temp_40_start
    print(temp_40_total)
    if int(temp_40_total) > 210:
        report = 300 - (temp_40_total + 90)
        print('Heating incubation was too long by ' + str(report) + ' seconds. ')
    else:
        incubation = int(300 - (temp_40_total + 90))
        print('Incubation period of: ' + str(incubation) + ' seconds started. ')
        time.sleep(incubation)
    print('Sample incubated with purification-free lysis buffer for 5 minutes at room temperature. ')
    print('End extraction. ')
 
def stepAmp():
    print('Start amplification. ')
    # Heating the amplification chamber to ~40 degrees Celsius.
    temp_40()
    # Dispense 90 uL of rehydration buffer into the extraction chamber.
    print('The step of dispensing 90 uL of rehydration buffer into extraction buffer is temporarily skipped. ')
    
